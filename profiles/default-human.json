{
  "name": "default-human",
  "version": 1,
  "thresholds": {
    "minimumWords": 20,
    "minimumSentences": 3,
    "burstinessCVLong": 0.45,
    "burstinessCVShort": 0.4,
    "adjacentDelta": 4,
    "shortSentenceRatio": 0.15,
    "longSentenceRatio": 0.1,
    "mattr": {
      "id": 0.72,
