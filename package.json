{
  "name": "humanizer-lint",
  "version": "1.2.3",
  "description": "Make AI-generated text read like human writing — deterministic humanizer and anti-slop prose linter that detects and fixes robotic LLM patterns (uniform sentence rhythm, low burstiness, MATTR repetition, AI cliches) in English, Indonesian, Spanish, French, German, Portuguese, Malay, Chinese and 100+ languages. Local zero-dependency Node.js CLI, no network.",
  "type": "module",
  "engines": {
    "node": ">=18.3.0"
  },
  "bin": {
    "humanizer-lint": "scripts/analyze.mjs",
    "humanizer-fingerprint": "scripts/fingerprint.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "scripts/",
    "rules/",
    "profiles/"
  ],
  "scripts": {
    "test": "node --test tests/test-runner.mjs",
    "build:demo": "node demo/build.mjs"
  },
  "homepage": "https://humanizer.aiclub.ai.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanstd888/humanizer-lint.git"
  },
  "keywords": [
    "skills-sh",
    "agent-skill",
    "ai-humanizer",
    "humanizer",
    "anti-slop",
    "prose-linter",
    "stylometry",
    "burstiness",
    "mattr",
    "multilingual-nlp",
    "indonesian-nlp",
    "copywriting",
    "markdown-linter",
    "claude-code",
    "cursor-skill",
    "windsurf",
    "codex",
    "gemini-cli"
  ],
  "license": "MIT"
}
