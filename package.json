{
  "name": "humanizer-lint",
  "version": "1.2.2",
  "description": "Multilingual closed-loop AI text humanizer, anti-slop prose linter, and stylometric burstiness (CV) & MATTR validator (EN, ID, ES, MS, FR, DE, PT, ZH + 100+ universal languages via Intl.Segmenter). Zero dependencies.",
  "type": "module",
  "engines": {
    "node": ">=18.3.0"
  },
  "bin": {
    "humanizer-lint": "scripts/analyze.mjs",
    "humanizer-fingerprint": "scripts/fingerprint.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "scripts/",
    "rules/",
    "profiles/"
  ],
  "scripts": {
    "test": "node --test tests/test-runner.mjs",
    "build:demo": "node demo/build.mjs"
  },
  "homepage": "https://humanizer.aiclub.ai.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanstd888/humanizer-lint.git"
  },
  "keywords": [
    "skills-sh",
