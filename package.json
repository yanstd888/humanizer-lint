{
  "name": "humanizer-lint",
  "version": "1.5.1",
  "description": "A local, zero-dependency prose linter that flags stiff, AI-sounding writing (stock phrases, flat sentence rhythm, repeated wording) and tells you what to revise. A style checker, not an AI detector.",
  "type": "module",
  "engines": {
    "node": ">=18.3.0"
  },
  "bin": {
    "humanizer-lint": "scripts/analyze.mjs",
    "humanizer-fingerprint": "scripts/fingerprint.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "index.mjs",
    "index.d.ts",
    "scripts/",
    "!scripts/docs-snapshot.mjs",
    "rules/",
    "profiles/",
    "references/",
    "benchmark/",
    "schemas/"
  ],
  "scripts": {
    "test:core": "node tests/test-runner.mjs",
    "test:demo": "node demo/build.mjs && node tests/demo-test.mjs && node tests/consistency-test.mjs && node tests/locales-test.mjs",
    "test": "npm run test:core && npm run test:demo && node scripts/docs-snapshot.mjs --check",
    "build:demo": "node demo/build.mjs",
    "benchmark": "node scripts/benchmark.mjs --table",
    "eval": "node scripts/eval.mjs",
    "mine-patterns": "node scripts/mine-patterns.mjs"
  },
  "homepage": "https://humanizer.aiclub.ai.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanstd888/humanizer-lint.git"
  },
  "keywords": [
    "skills-sh",
    "agent-skill",
    "ai-humanizer",
    "humanizer",
    "anti-slop",
    "prose-linter",
    "stylometry",
    "burstiness",
    "mattr",
    "multilingual-nlp",
    "indonesian-nlp",
    "copywriting",
    "markdown-linter",
    "claude-code",
    "cursor-skill",
    "windsurf",
    "codex",
    "gemini-cli"
  ],
  "license": "MIT",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "author": "Muhammad Dian (yanstd888)",
  "bugs": {
    "url": "https://github.com/yanstd888/humanizer-lint/issues"
  }
}
