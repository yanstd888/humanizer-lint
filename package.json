{
  "name": "humanizer-lint",
  "version": "1.4.1",
  "description": "Deterministic prose linter and stylometric rhythm analyzer with 8 language-specific anti-cliche packs plus universal Intl.Segmenter diagnostics for 100+ languages. Local zero-dependency Node.js CLI, no network.",
  "type": "module",
  "engines": {
    "node": ">=18.3.0"
  },
  "bin": {
    "humanizer-lint": "scripts/analyze.mjs",
    "humanizer-fingerprint": "scripts/fingerprint.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "scripts/",
    "rules/",
    "profiles/",
    "demo/samples.mjs"
  ],
  "scripts": {
    "test": "node demo/build.mjs && node --test tests/test-runner.mjs",
    "build:demo": "node demo/build.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "homepage": "https://humanizer.aiclub.ai.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanstd888/humanizer-lint.git"
  },
  "keywords": [
    "skills-sh",
    "agent-skill",
    "ai-humanizer",
    "humanizer",
    "anti-slop",
    "prose-linter",
    "stylometry",
    "burstiness",
    "mattr",
    "multilingual-nlp",
    "indonesian-nlp",
    "copywriting",
    "markdown-linter",
    "claude-code",
    "cursor-skill",
    "windsurf",
    "codex",
    "gemini-cli"
  ],
  "license": "MIT"
}
